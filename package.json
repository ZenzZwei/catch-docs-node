{
  "name": "catchdocs",
  "version": "0.1.0",
  "description": "Crawl login-protected wiki/docs sites and export them as a Markdown tree for AI consumption.",
  "type": "module",
  "bin": {
    "catchdocs": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "serve": "tsx src/cli.ts serve",
    "login": "tsx src/cli.ts login",
    "crawl": "tsx src/cli.ts crawl",
    "bundle": "node scripts/build-portable.mjs",
    "pack": "node scripts/build-sea.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "commander": "^12.1.0",
    "p-limit": "^6.1.0",
    "playwright": "^1.47.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/turndown": "^5.0.6",
    "dompurify": "^3.4.1",
    "esbuild": "^0.28.0",
    "marked": "^14.1.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
